import numpy as np 
import cv2 
#播放视频文件
cap2= cv2.VideoCapture(r"C:\\Users\\HUAWEI\\Desktop\\qq.mp4")
while(cap2.isOpened()): 
    ret, frame = cap2.read() 
    cv2.imshow('frame',frame) 
    c = cv2.waitKey(25) 
    if c==27:   #ESC 键 
        break 
cap2.release() 
#捕获摄像头视频
cap1 = cv2.VideoCapture(0) 
while(cap1.isOpened()): 
    ret, frame = cap1.read() 
    cv2.imshow('frame',frame) 
    c = cv2.waitKey(1) 
    if c==27:   #ESC 键 
        break 
cap1.release()
cv2.destroyAllWindows() 
