import cv2
import numpy as np
a=cv2.imread(r"C:\\Users\\HUAWEI\\Pictures\\cute.png")
#对图像进行部分截取
b=a[200:400,200:400]
cv2.imshow("a",a)
cv2.imshow("b",b)
cv2.waitKey()
c=np.random.randint(0,255,(200,200,3))
a[200:400,200:400]=c
cv2.imshow("ac",a)
cv2.waitKey()
#通道拆分
a[200:400,200:400]=b
#也可以写成d=cv2.split(a)[0]
d=a[ : , : ,0]
cv2.imshow("d",d)
cv2.waitKey()
#还可以整体拆分
B,G,R=cv2.split(a)
cv2.imshow("B",B)
cv2.waitKey()
cv2.imshow("G",G)
cv2.waitKey()
cv2.imshow("R",R)
cv2.waitKey()
#然后再重组
bgr=cv2.merge([B,G,R])
gbr=cv2.merge([G,B,R])
cv2.imshow("bgr",bgr)
cv2.waitKey()
cv2.imshow("gbr",gbr)
cv2.waitKey()
#获得图像行，列，（通道）
print(a.shape)
#获取像素数
print(a.size)
#获取图像数据类型
print(a.dtype)
